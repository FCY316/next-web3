# production 环境的非敏感默认配置，可提交到仓库。
# 私密配置放在同目录 production.local.env 中，或由部署平台注入。

# 仅服务端可读取：process.env.APP_ENV。
# 不带 NEXT_PUBLIC_ 前缀的变量不会自动暴露给浏览器，可用于服务端私密配置。
APP_ENV=production

# 服务端和浏览器端均可读取：process.env.NEXT_PUBLIC_APP_ENV。
# NEXT_PUBLIC_ 前缀变量会公开到浏览器，禁止存放数据库密码、私密 API Key 等密钥。
# 浏览器端的值在构建时固定，修改后必须重新构建并部署。
# 请直接使用 process.env.NEXT_PUBLIC_APP_ENV，避免通过动态属性名读取。
NEXT_PUBLIC_APP_ENV=production

# 后续按需要添加 API 地址、数据库连接等变量。
# 上面两个环境标识由 scripts/next-env.mjs 按命令统一设置，无需手动修改。
